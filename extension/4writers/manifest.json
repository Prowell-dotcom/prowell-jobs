{
  "manifest_version": 3,
  "name": "Prowell 4writers Order Watcher",
  "version": "0.5.2",
  "description": "Order-card detection, two-second refresh, processing-view test and staged acceptance assistant for 4writers (beta).",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://4writers.net/*",
    "https://www.4writers.net/*",
    "https://prowelljobs.com/*"
  ],
  "action": {
    "default_title": "Prowell Order Assistant",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://4writers.net/*",
        "https://www.4writers.net/*"
      ],
      "js": [
        "order-card.js",
        "content.js",
        "refresh.js"
      ],
      "run_at": "document_start"
    }
  ]
}
