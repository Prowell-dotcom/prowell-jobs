{
  "manifest_version": 3,
  "name": "Prowell Good-Writers Assistant",
  "version": "1.0.2",
  "description": "Order-card detection, two-second refresh, processing-view test and staged acceptance assistant for good-writers (beta).",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://good-writers.com/*",
    "https://www.good-writers.com/*",
    "https://prowelljobs.com/*"
  ],
  "action": {
    "default_title": "Good-Writers Assistant",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://good-writers.com/*",
        "https://www.good-writers.com/*"
      ],
      "js": [
        "order-card.js",
        "content.js",
        "refresh.js"
      ],
      "run_at": "document_start"
    }
  ]
}
