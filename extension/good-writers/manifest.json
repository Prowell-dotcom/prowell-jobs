{
  "manifest_version": 3,
  "name": "Prowell Good-Writers Assistant",
  "version": "1.0.8",
  "description": "View-only order watcher: detect, stop, sound alert, and open View for manual order review.",
  "permissions": [
    "storage",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "https://good-writers.com/*",
    "https://www.good-writers.com/*",
    "https://prowelljobs.com/*"
  ],
  "action": {
    "default_title": "Good-Writers Assistant",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://good-writers.com/*",
        "https://www.good-writers.com/*"
      ],
      "js": [
        "order-card.js",
        "content.js",
        "refresh.js"
      ],
      "run_at": "document_start"
    }
  ]
}
