{
  "manifest_version": 3,
  "name": "Prowell Dual-Platform Instant Bot",
  "version": "2.1.15",
  "description": "Earlier supplied 4writers and Good-Writers engines with sound alerts, plus Writings/Rewritings monitoring in 4writers.",
  "permissions": [
    "storage",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "https://4writers.net/*",
    "https://www.4writers.net/*",
    "https://good-writers.com/*",
    "https://www.good-writers.com/*",
    "https://prowelljobs.com/*"
  ],
  "action": {
    "default_title": "Prowell Dual-Platform Instant Bot",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://4writers.net/*",
        "https://www.4writers.net/*"
      ],
      "js": [
        "legacy/four/confirm-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://good-writers.com/*",
        "https://www.good-writers.com/*"
      ],
      "js": [
        "legacy/good/confirm-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://4writers.net/*",
        "https://www.4writers.net/*"
      ],
      "js": [
        "scoped-store.js",
        "legacy-bridge.js",
        "legacy/four/order-card.js",
        "four-sections.js",
        "legacy-order-sound.js",
        "legacy/four/runtime-content.js",
        "four-section-refresh.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://good-writers.com/*",
        "https://www.good-writers.com/*"
      ],
      "js": [
        "scoped-store.js",
        "legacy-bridge.js",
        "legacy/good/order-card.js",
        "legacy-order-sound.js",
        "legacy/good/runtime-content.js",
        "legacy/good/runtime-refresh.js"
      ],
      "run_at": "document_start"
    }
  ]
}
